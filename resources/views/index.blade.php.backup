<meta name="author" content="Flavory.id">

<style>
    /* Variabel Warna Utama */
    :root {
        --primary-orange: #ff6a00;
        --light-orange: #fff4ec;
        --text-muted: #64748b;
    }

    /* Animasi Dasar */
    .animate-slide-up {
        opacity: 0;
        transform: translateY(30px);
        transition: opacity 0.8s ease-out, transform 0.8s ease-out;
    }
    .animate-fade-in {
        opacity: 0;
        transition: opacity 1s ease-out;
    }
    .in-view {
        opacity: 1;
        transform: translateY(0);
    }

    /* Hero Section */
    .hero-section {
        padding: 120px 0 80px;
        background: linear-gradient(135deg, #ffffff 0%, var(--light-orange) 100%);
        overflow: hidden;
    }
    .hero-title { font-size: 3.2rem; line-height: 1.35; font-weight: 800; letter-spacing: -1px; }
    .hero-subtitle { font-size: 1.15rem; color: var(--text-muted); margin-bottom: 30px; line-height: 1.6; }

    /* ── Word Blur Reveal ── */

    /* Setiap kata dibungkus <span class="w"> oleh JS */
    .hero-title .w,
    .hero-subtitle .w,
    .hero-cta .w {
        display: inline-block;
        opacity: 0;
        filter: blur(8px);
        transform: translateY(12px);
        transition:
            opacity   0.5s ease,
            filter    0.5s ease,
            transform 0.5s ease;
        will-change: opacity, filter, transform;
    }

    /* Badge */
    .hero-badge-wrap {
        opacity: 0;
        filter: blur(6px);
        transform: translateY(10px);
        transition: opacity 0.5s ease, filter 0.5s ease, transform 0.5s ease;
        will-change: opacity, filter, transform;
    }

    /* Rotating line — container tidak berubah, konten di dalamnya yang swap */
    #hero-rotating-line {
        display: block;
        min-height: 1.5em;   /* lebih tinggi agar frasa panjang tidak shift layout */
        position: relative;
    }
    #hero-rotating-line .rot-word {
        display: inline-block;
        opacity: 0;
        filter: blur(10px);
        transform: translateY(14px);
        transition: opacity 0.45s ease, filter 0.45s ease, transform 0.45s ease;
        will-change: opacity, filter, transform;
    }
    #hero-rotating-line .rot-word.rot-in {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
    }
    #hero-rotating-line .rot-word.rot-out {
        opacity: 0;
        filter: blur(8px);
        transform: translateY(-12px);
        transition: opacity 0.3s ease, filter 0.3s ease, transform 0.3s ease;
    }

    /* State visible — ditambah JS per kata */
    .w.visible {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
    }
    .hero-badge-wrap.visible {
        opacity: 1;
        filter: blur(0);
        transform: translateY(0);
    }

    /* State exit — transisi keluar lebih cepat */
    .w.hidden {
        opacity: 0;
        filter: blur(6px);
        transform: translateY(-10px);
        transition:
            opacity   0.3s ease,
            filter    0.3s ease,
            transform 0.3s ease;
    }
    .hero-badge-wrap.hidden {
        opacity: 0;
        filter: blur(4px);
        transform: translateY(-8px);
        transition: opacity 0.3s ease, filter 0.3s ease, transform 0.3s ease;
    }

    /* Buttons */
    .btn-orange {
        background-color: var(--primary-orange);
        color: #fff;
        border: none;
        transition: all 0.3s ease;
    }
    .btn-orange:hover {
        background-color: #e65f00;
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(255, 106, 0, 0.2);
        color: #fff;
    }
    .btn-outline-orange {
        border: 2px solid var(--primary-orange);
        color: var(--primary-orange);
        background: transparent;
        transition: all 0.3s ease;
    }
    .btn-outline-orange:hover {
        background-color: var(--primary-orange);
        color: #fff;
        transform: translateY(-2px);
    }

    /* Features Box */
    .feature-icon-box {
        width: 60px; height: 60px;
        background-color: var(--light-orange);
        color: var(--primary-orange);
        border-radius: 16px;
        display: flex; align-items: center; justify-content: center;
        font-size: 1.8rem; margin-bottom: 20px;
        transition: transform 0.3s ease;
    }
    .feature-card {
        border: 1px solid rgba(0,0,0,0.05);
        border-radius: 20px;
        padding: 30px;
        transition: all 0.3s ease;
        height: 100%;
        background: white;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }
    .feature-card:hover { 
        transform: translateY(-10px); 
        box-shadow: 0 15px 40px rgba(255, 106, 0, 0.08); 
    }
    .feature-card:hover .feature-icon-box {
        transform: scale(1.1);
    }

    /* Highlight Fitur AI & Prediksi */
    .feature-highlight-card {
        background: #fff;
        border-left: 4px solid var(--primary-orange);
        border-radius: 12px;
        padding: 24px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
        transition: all 0.3s ease;
    }
    .feature-highlight-card:hover {
        box-shadow: 0 8px 25px rgba(255, 106, 0, 0.1);
        transform: translateX(5px);
    }

    /* Pricing Box */
    .pricing-card {
        border-radius: 24px;
        border: 2px solid #f1f5f9;
        padding: 40px 30px;
        background: white;
        transition: all 0.3s;
        position: relative;
        height: 100%;
        display: flex;
        flex-direction: column;
    }
    .pricing-card.popular {
        border-color: var(--primary-orange);
        box-shadow: 0 20px 40px rgba(255, 106, 0, 0.15);
        transform: scale(1.05);
        z-index: 10;
        background: linear-gradient(to bottom, #ffffff, #fffdfa);
    }
    .badge-popular {
        position: absolute; top: -15px; left: 50%; transform: translateX(-50%);
        background: var(--primary-orange); color: white;
        padding: 6px 24px; border-radius: 20px; font-weight: 700; font-size: 0.85rem;
        box-shadow: 0 4px 10px rgba(255, 106, 0, 0.3);
        letter-spacing: 0.5px;
    }
    .price-strike { text-decoration: line-through; color: #94a3b8; font-size: 1.1rem; font-weight: 500; margin-right: 8px; }
    .promo-tag { background: #fee2e2; color: #ef4444; font-size: 0.75rem; font-weight: 700; padding: 4px 10px; border-radius: 6px; }

    /* Check List */
    .check-list { list-style: none; padding-left: 0; flex-grow: 1; }
    .check-list li { margin-bottom: 12px; display: flex; align-items: flex-start; }
    .check-list i { color: var(--primary-orange); margin-right: 12px; font-size: 1.2rem; margin-top: -2px; }

    /* Bonus Banner */
    .bonus-banner {
        background: linear-gradient(45deg, var(--primary-orange), #ff8c33);
        border-radius: 24px;
        color: white;
        position: relative;
        overflow: hidden;
    }

    @media (max-width: 991px) {
        .hero-title { font-size: 2.5rem; }
        .pricing-card.popular { transform: scale(1); margin-top: 2rem; margin-bottom: 2rem; }
    }

    /* Blog Section */
    .blog-card {
        border: 1px solid rgba(0,0,0,0.06);
        border-radius: 20px;
        overflow: hidden;
        background: #fff;
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
        box-shadow: 0 4px 15px rgba(0,0,0,0.03);
    }
    .blog-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 16px 40px rgba(255, 106, 0, 0.1);
        border-color: rgba(255, 106, 0, 0.2);
    }
    .blog-card-img {
        aspect-ratio: 16/9;
        object-fit: cover;
        width: 100%;
        background: #f8f9fa;
    }
    .blog-card-body {
        padding: 20px;
        flex: 1;
        display: flex;
        flex-direction: column;
    }
    .blog-category-badge {
        font-size: 0.72rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        background: var(--light-orange);
        color: var(--primary-orange);
        padding: 4px 10px;
        border-radius: 6px;
        display: inline-block;
        margin-bottom: 10px;
    }
    .blog-card-title {
        font-size: 0.97rem;
        font-weight: 700;
        line-height: 1.45;
        color: #1a202c;
        margin-bottom: 8px;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .blog-card-excerpt {
        font-size: 0.82rem;
        color: #64748b;
        line-height: 1.6;
        flex: 1;
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        margin-bottom: 16px;
    }
    .blog-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-top: 1px solid #f1f5f9;
        padding-top: 12px;
        margin-top: auto;
    }
    .blog-read-link {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--primary-orange);
        text-decoration: none;
        display: flex;
        align-items: center;
        gap: 4px;
        transition: gap 0.2s ease;
    }
    .blog-read-link:hover { gap: 8px; color: #e65f00; }
    .blog-date {
        font-size: 0.75rem;
        color: #94a3b8;
    }

    /* ===== MINEAI SPOTLIGHT SECTION ===== */
    @keyframes mineShift {
        0%   { background-position: 0% 50%; }
        50%  { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    @keyframes mineOrbFloat {
        0%,100% { transform: translate(0,0) scale(1); }
        33%     { transform: translate(30px,-25px) scale(1.06); }
        66%     { transform: translate(-20px,18px) scale(.95); }
    }
    @keyframes mineScreenFloat {
        0%,100% { transform: translateY(0) rotate(-1.5deg); }
        50%     { transform: translateY(-12px) rotate(-1.5deg); }
    }

    .mineai-section {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #fff4ec 0%, #fdf0f8 40%, #fff8f0 70%, #fdeef8 100%);
        background-size: 400% 400%;
        animation: mineShift 10s ease infinite;
        padding: 80px 0;
        border-top: 3px solid transparent;
        border-image: linear-gradient(135deg, #ff6a00, #ee0979) 1;
    }

    /* Orbs */
    .mineai-orb {
        position: absolute; border-radius: 50%;
        filter: blur(80px); pointer-events: none; z-index: 1;
    }
    .mineai-orb1 {
        width: 600px; height: 600px;
        background: radial-gradient(circle, rgba(255,106,0,.18), transparent 65%);
        top: -20%; left: -10%;
        animation: mineOrbFloat 11s ease-in-out infinite;
    }
    .mineai-orb2 {
        width: 450px; height: 450px;
        background: radial-gradient(circle, rgba(238,9,121,.14), transparent 65%);
        bottom: -15%; right: -8%;
        animation: mineOrbFloat 13s ease-in-out infinite reverse;
    }
    .mineai-orb3 {
        width: 300px; height: 300px;
        background: radial-gradient(circle, rgba(255,154,0,.12), transparent 65%);
        top: 40%; left: 35%;
        animation: mineOrbFloat 8s ease-in-out infinite 2s;
    }

    /* Logo badge */
    .mineai-logo-badge {
        width: 52px; height: 52px;
        border-radius: 14px;
        object-fit: cover;
        box-shadow: 0 8px 24px rgba(255,106,0,.4);
    }

    /* Tag */
    .mineai-tag {
        display: inline-block;
        font-size: .68rem; font-weight: 800; letter-spacing: 1.5px;
        text-transform: uppercase;
        background: linear-gradient(135deg, #ff6a00, #ee0979);
        background-size: 200% 200%;
        animation: mineShift 3s ease infinite;
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 2px; display: block;
    }
    .mineai-name-text {
        font-size: 1.6rem; font-weight: 900; color: var(--text-dark); line-height: 1;
    }
    .mineai-name-text span {
        background: linear-gradient(135deg, #ff6a00, #ee0979);
        background-size: 200% 200%;
        animation: mineShift 3s ease infinite;
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* Headline */
    .mineai-headline {
        font-size: clamp(1.8rem, 3.5vw, 2.6rem);
        font-weight: 900;
        color: #1e1e2e;
        line-height: 1.2;
        margin-bottom: 1.2rem;
    }
    .mineai-grad-text {
        background: linear-gradient(135deg, #ff6a00, #ee0979, #ff9a00);
        background-size: 300% 300%;
        animation: mineShift 4s ease infinite;
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    /* Desc */
    .mineai-desc {
        color: #475569;
        font-size: .93rem;
        line-height: 1.75;
        margin-bottom: 1.5rem;
    }

    /* Feature list */
    .mineai-features li {
        color: #334155;
        font-size: .88rem;
        margin-bottom: .6rem;
        display: flex; align-items: center; gap: 10px;
    }
    .mineai-features li i {
        background: linear-gradient(135deg, #ff6a00, #ee0979);
        background-size: 200%; animation: mineShift 3s ease infinite;
        -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        background-clip: text;
        font-size: 1rem; flex-shrink: 0;
    }

    /* CTA buttons */
    .btn-mineai-cta {
        display: inline-flex; align-items: center;
        padding: 13px 28px; border-radius: 50px; border: none;
        font-weight: 800; font-size: .9rem; color: white;
        text-decoration: none; cursor: pointer;
        background: linear-gradient(135deg, #ff6a00, #ee0979, #ff9a00, #ff6a00);
        background-size: 300% 300%;
        animation: mineShift 3s ease infinite;
        box-shadow: 0 8px 28px rgba(255,106,0,.4);
        transition: transform .25s, box-shadow .25s;
    }
    .btn-mineai-cta:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 36px rgba(238,9,121,.5);
        color: white;
    }
    .btn-mineai-ghost {
        display: inline-flex; align-items: center;
        padding: 13px 24px; border-radius: 50px;
        border: 1.5px solid rgba(255,106,0,.4);
        font-weight: 700; font-size: .88rem;
        color: #ff6a00;
        text-decoration: none;
        background: rgba(255,106,0,.06);
        transition: all .25s;
    }
    .btn-mineai-ghost:hover {
        border-color: #ee0979;
        background: rgba(238,9,121,.08);
        color: #ee0979;
    }

    /* Screenshot */
    .mineai-screen-wrap {
        position: relative;
        padding: 4px;
        border-radius: 24px;
    }
    .mineai-screen-glow {
        position: absolute; inset: -20px;
        background: radial-gradient(ellipse at center, rgba(238,9,121,.25) 0%, transparent 70%);
        border-radius: 40px;
        pointer-events: none;
        animation: mineOrbFloat 7s ease-in-out infinite;
    }
    .mineai-screenshot {
        width: 100%;
        border-radius: 20px;
        box-shadow: 0 20px 60px rgba(255,106,0,.2), 0 4px 20px rgba(238,9,121,.1), 0 0 0 1px rgba(255,106,0,.15);
        display: block;
        animation: mineScreenFloat 6s ease-in-out infinite;
    }

    @media (max-width: 991px) {
        .mineai-section { padding: 60px 0; }
        .mineai-headline { font-size: 1.9rem; }
        .mineai-screenshot { animation: none; }
    }
</style>
@endpush

